<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= message.subject %></title>
  </head>
  <body style="margin: 0; padding: 0; background: <%= email_background %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: <%= email_background %>;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                 style="max-width: 560px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;">
            <tr>
              <td align="center" style="padding: 0 0 20px;">
                <% if @product&.logo_url.present? %>
                  <%= image_tag @product.logo_url, alt: @data[:product_name], height: 48,
                        style: "display: block; height: 48px; width: auto; border: 0;" %>
                <% else %>
                  <span style="font-size: 22px; font-weight: 700; color: <%= EmailHelper::INK %>;"><%= @data[:product_name] %></span>
                <% end %>
              </td>
            </tr>
            <tr>
              <td style="padding: 32px; border-radius: 16px; background: #ffffff; border-top: 6px solid <%= email_accent %>;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 20px 0 0; font-size: 13px; line-height: 1.5; color: <%= EmailHelper::MUTED %>;">
                Questions? Just reply to this email.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
